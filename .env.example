# ============================================================
# 短网址服务系统 —— 环境变量模板
# 用法：复制成 .env，把占位符换成真实值。.env 已在 .gitignore 里，不会进 Git。
#   Copy-Item .env.example .env
# 生成随机口令（PowerShell）：
#   -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
# ============================================================

# ---- 固定镜像标签（不要写 latest / stable，标签会移动）----
SHLINK_TAG=5.1.6
POSTGRES_TAG=16.14-alpine
WEB_TAG=1.0.0

# ---- 数据库口令：只放这里，不进 Git ----
POSTGRES_PASSWORD=__在这里填你的随机口令__

# ---- Shlink 首次初始化生成的 API Key；生成后不要再改，否则要重建库 ----
INITIAL_API_KEY=__在这里填一段随机字符串__

# ---- 短链的对外域名。本地实验就是 localhost:8080，不要带 http:// ----
DEFAULT_DOMAIN=localhost:8080
IS_HTTPS_ENABLED=false

# ---- Web 界面容器对外端口 ----
WEB_PORT=8501

# ---- 自主功能：创建频率限制（同一 IP 在窗口内最多创建多少条）----
XIANZHI_CHUANGJIAN_CISHU=20
XIANZHI_CHUANGJIAN_CHUANGKOU_MIAO=60

# ---- 自主功能：短链有效期上限（天），防止有人建 10 年有效的短链 ----
XIANZHI_ZUIDA_YOUXIAOQI_TIAN=365
